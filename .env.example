# ==============================================================================
# Andalusia Music Platform — Environment Variables Template (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env.local' for local development:
#    cp .env.example .env.local
# 2. Populate the required values for your local or remote Supabase instance.
# 3. NEVER commit '.env.local', '.env.production', or any real secrets to Git.
#
# CRITICAL SECURITY RULES:
# - Variables starting with 'NEXT_PUBLIC_' are embedded into the client JavaScript bundle.
#   Only assign values that are safe for public web visitors to inspect.
# - Variables WITHOUT 'NEXT_PUBLIC_' are strictly SERVER-ONLY.
# - 'SUPABASE_SERVICE_ROLE_KEY' must NEVER be prefixed with 'NEXT_PUBLIC_'
#   and must NEVER be referenced in Client Components ('use client').
# ==============================================================================

# ==============================================================================
# 1. CLIENT-SAFE / PUBLIC ENVIRONMENT VARIABLES
# ==============================================================================

# Supabase Project Base URL
# Purpose: Directs browser and server clients to the Supabase gateway (PostgREST & Auth).
# Scope: Client-Safe (Public) | Required
# Development: http://127.0.0.1:54321 (Local Supabase CLI) or https://<dev-ref>.supabase.co
# Production: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous API Key
# Purpose: Unprivileged JWT key for public visitors. Governed strictly by PostgreSQL RLS.
# Scope: Client-Safe (Public) | Required
# Development: Local CLI anon key or dev project anon key
# Production: Production project anon key from Supabase Dashboard
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Canonical Application Site URL
# Purpose: Base URL for SEO metadata (canonical, OpenGraph), sitemaps, and Auth redirects.
# Scope: Client-Safe (Public) | Required
# Development: http://localhost:3000
# Production: https://andalusia.art
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Storage Public CDN Base URL (Optional)
# Purpose: Custom CDN domain or proxy endpoint for resolving uploaded media assets.
# Scope: Client-Safe (Public) | Optional (Defaults to ${NEXT_PUBLIC_SUPABASE_URL}/storage/v1/object/public)
# Development: Leave blank to use standard Supabase storage endpoint
# Production: https://media.andalusia.art/storage/v1/object/public
NEXT_PUBLIC_SUPABASE_STORAGE_URL=

# Default Platform Locale (Optional)
# Purpose: Initial language and text direction fallback ('ar' = RTL Arabic).
# Scope: Client-Safe (Public) | Optional (Defaults to 'ar')
# Values: ar | en
NEXT_PUBLIC_DEFAULT_LOCALE=ar

# Cloudflare Turnstile Bot Defense Site Key (Optional)
# Purpose: Renders anti-bot challenge widget on public booking & subscription forms.
# Scope: Client-Safe (Public) | Optional in local dev, Recommended in production
# Development: 1x00000000000000000000AA (Cloudflare always-pass dummy key)
# Production: 0x4AAAAAA... (Cloudflare Turnstile site key)
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=


# ==============================================================================
# 2. SERVER-ONLY / SECRET ENVIRONMENT VARIABLES
# ==============================================================================

# Supabase Service Role Key
# Purpose: Superuser API key that bypasses all Row Level Security (RLS) policies.
# Scope: SERVER-ONLY / HIGH-CRITICALITY SECRET | Required for migrations, seeds, admin tasks
# WARNING: NEVER expose to client bundles or use in 'use client' files.
# Development: Local CLI service_role key from 'npx supabase status'
# Production: Supabase Dashboard -> Project Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Direct PostgreSQL Connection String (Optional / CLI & Seed Tooling)
# Purpose: Direct or connection-pooled connection string for SQL migrations and seed scripts.
# Scope: SERVER-ONLY / SECRET | Optional (Standard Next.js runtime uses HTTPS PostgREST)
# Development: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Production: postgresql://postgres:[PASSWORD]@db.<project-ref>.supabase.co:6543/postgres?pgbouncer=true
DATABASE_URL=

# Resend Transactional Email API Key (Optional in Dev / Recommended in Production)
# Purpose: Dispatches transactional alert emails when new booking requests are received.
# Scope: SERVER-ONLY / SECRET | Optional in local dev (falls back to console logger)
# Development: Leave empty to mock email delivery via server console logging
# Production: re_123456789_abcdefghijklmnopqrstuvwxyz
RESEND_API_KEY=

# Booking Lead Notification Recipient Email
# Purpose: Target inbox to receive notifications when booking inquiries are submitted.
# Scope: SERVER-ONLY | Optional (Defaults to hello@andalusia.art)
# Development: dev-inbox@example.com
# Production: hello@andalusia.art
NOTIFICATION_EMAIL_TO=hello@andalusia.art

# Booking Lead Notification Sender Email
# Purpose: Verified sender address used by the email provider.
# Scope: SERVER-ONLY | Optional (Defaults to notifications@andalusia.art)
# Development: onboarding@resend.dev (Resend test sandbox)
# Production: notifications@andalusia.art (Domain verified in Resend)
NOTIFICATION_EMAIL_FROM=notifications@andalusia.art

# Cloudflare Turnstile Secret Key (Optional in Dev / Recommended in Production)
# Purpose: Server Action verification of Turnstile challenge tokens before database insert.
# Scope: SERVER-ONLY / SECRET | Optional in local dev
# Development: 1x0000000000000000000000000000000AA (Cloudflare dummy pass secret)
# Production: 0x4AAAAAA... (Cloudflare Turnstile secret key)
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Internal Cron / Webhook Authorization Secret (Optional)
# Purpose: Bearer token to protect scheduled maintenance Route Handlers (e.g. /api/cron/publish).
# Scope: SERVER-ONLY / SECRET | Optional
# Development: test-cron-secret-12345
# Production: Cryptographically random 64-character hex string (e.g., openssl rand -hex 32)
CRON_SECRET=
